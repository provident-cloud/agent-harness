#!/usr/bin/env python3
"""A stand-in for the Codex CLI (exec mode), for replay checks. Canned replies.

Covers what mcp/delegate-server/adapters.py CodexAdapter runs:

    codex exec --json -s <sandbox> -C <dir> -c ... [-m M] -- <prompt>
    codex exec resume --json -c ... [-m M] -- <thread_id> <prompt>   (cwd = dir)
    codex mcp list --json                                           -> []

and prints the JSON-lines events the real CLI does (thread.started,
turn.started, item.completed agent_message, turn.completed usage). It insists
on the -c overrides the adapter must send (approval_policy, sandbox_mode,
developer_instructions). In a workspace-write sandbox it writes
DELEGATED-<n>.md into the directory. Thread ids (thread-<n>) are remembered in
the repo's common git dir, so resume works across processes and worktrees; an
unknown id fails like the real CLI ("no rollout found").

Knobs: FAKE_CODEX_SLEEP (seconds per call), FAKE_CODEX_LOG (one JSON line per
call), FAKE_CODEX_PIDFILE (this process's pid, written at start),
FAKE_BARRIER_DIR + FAKE_BARRIER_COUNT (wait until that many fakes have entered,
to prove calls overlap). A prompt containing FAKE:fail fails the turn.
"""
from __future__ import annotations

import json
import os
import subprocess
import sys
import time
from pathlib import Path

T0 = time.time()


def emit(obj: dict) -> None:
    sys.stdout.write(json.dumps(obj) + "\n")
    sys.stdout.flush()


def barrier() -> bool:
    d, n = os.environ.get("FAKE_BARRIER_DIR"), int(os.environ.get("FAKE_BARRIER_COUNT") or 0)
    if not d or n < 2:
        return True
    Path(d).mkdir(parents=True, exist_ok=True)
    (Path(d) / str(os.getpid())).touch()
    deadline = time.time() + 15
    while time.time() < deadline:
        if len(list(Path(d).iterdir())) >= n:
            return True
        time.sleep(0.1)
    return False


def state_file(cwd: Path) -> Path | None:
    common = subprocess.run(["git", "-C", str(cwd), "rev-parse", "--git-common-dir"],
                            capture_output=True, text=True)
    if common.returncode != 0:
        return None
    return (cwd / common.stdout.strip() / "fake-codex-threads.json").resolve()


def parse(args: list[str]) -> tuple[dict[str, str], list[str], list[str]]:
    """(-s/-C/-m values, -c overrides, positionals after --)."""
    opts: dict[str, str] = {}
    configs: list[str] = []
    i = 0
    while i < len(args):
        a = args[i]
        if a == "--":
            return opts, configs, args[i + 1:]
        if a in ("-s", "-C", "-m"):
            opts[a] = args[i + 1]
            i += 2
            continue
        if a == "-c":
            configs.append(args[i + 1])
            i += 2
            continue
        i += 1
    return opts, configs, []


def run(resume: bool, args: list[str]) -> int:
    pidfile = os.environ.get("FAKE_CODEX_PIDFILE")
    if pidfile:
        Path(pidfile).write_text(str(os.getpid()))
    opts, configs, pos = parse(args)
    keys = {c.split("=", 1)[0] for c in configs}
    for need in ("approval_policy", "sandbox_mode", "developer_instructions"):
        if need not in keys:
            print(f"fake codex: missing -c {need}", file=sys.stderr)
            return 2
    if 'approval_policy="never"' not in configs:
        print("fake codex: approval_policy must be never", file=sys.stderr)
        return 2
    sandbox = next(c.split("=", 1)[1].strip('"') for c in configs if c.startswith("sandbox_mode="))
    if resume:
        if len(pos) != 2:
            print("fake codex: resume wants -- <id> <prompt>", file=sys.stderr)
            return 2
        thread, prompt = pos
        cwd = Path.cwd()
    else:
        if "-s" not in opts or "-C" not in opts or len(pos) != 1 or opts["-s"] != sandbox:
            print(f"fake codex: bad exec args {args}", file=sys.stderr)
            return 2
        thread, prompt, cwd = "", pos[0], Path(opts["-C"])
    state = state_file(cwd)
    known: dict[str, str] = json.loads(state.read_text()) if state and state.exists() else {}
    if resume and thread not in known:
        print(f"Error: thread/resume: thread/resume failed: no rollout found for thread id "
              f"{thread} (code -32600)", file=sys.stderr)
        return 1
    met = barrier()
    delay = float(os.environ.get("FAKE_CODEX_SLEEP") or 0)
    if delay:
        time.sleep(delay)
    if not resume:
        thread = f"thread-{len(known) + 1}"
        known[thread] = str(cwd)
        if state:
            state.write_text(json.dumps(known))
    emit({"type": "thread.started", "thread_id": thread})
    emit({"type": "turn.started"})
    if "FAKE:fail" in prompt:
        emit({"type": "turn.failed", "error": {"message": "simulated failure inside the turn"}})
        return 1
    written = ""
    if sandbox == "workspace-write" and not resume:
        target = cwd / f"DELEGATED-{len(known)}.md"
        target.write_text(f"# delegated\n\n{prompt}\n")
        written = str(target)
    log = os.environ.get("FAKE_CODEX_LOG")
    if log:
        with open(log, "a") as fh:
            fh.write(json.dumps({"pid": os.getpid(), "cwd": str(cwd), "sandbox": sandbox,
                                 "written": written, "model": opts.get("-m", ""),
                                 "cli": "codex", "barrier_met": met, "t_start": T0, "t_done": time.time()}) + "\n")
    text = f"fake codex: replied on {thread}" if resume else f"fake codex: done in {sandbox} sandbox"
    emit({"type": "item.completed", "item": {"id": "item_0", "type": "agent_message", "text": text}})
    usage = (300, 12) if resume else (1200, 34)
    emit({"type": "turn.completed", "usage": {"input_tokens": usage[0], "cached_input_tokens": 0,
                                              "output_tokens": usage[1]}})
    return 0


def main(argv: list[str]) -> int:
    if argv[:3] == ["mcp", "list", "--json"]:
        print("[]")
        return 0
    if argv[:1] == ["--version"]:
        print("codex-cli 0.0.0-fake")
        return 0
    if argv[:2] == ["exec", "resume"]:
        return run(True, argv[2:])
    if argv[:1] == ["exec"]:
        return run(False, argv[1:])
    print(f"fake codex: unsupported args {argv}", file=sys.stderr)
    return 2


if __name__ == "__main__":
    raise SystemExit(main(sys.argv[1:]))
