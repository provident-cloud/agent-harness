#!/usr/bin/env -S uv run --quiet --script
# /// script
# requires-python = ">=3.11"
# dependencies = ["pyyaml"]
# ///
"""Generate config/ for this harness and wire the workspace directory."""
from __future__ import annotations

import argparse
import os
import subprocess
import sys
import tempfile
from dataclasses import dataclass, field
from pathlib import Path
from typing import Any, Callable

sys.path.insert(0, str(Path(__file__).resolve().parent.parent / "lib"))
import harness_lib as h  # noqa: E402

import yaml  # noqa: E402  (declared above; used for the --print-answers dump)

DEFAULT_OSS_BASE = "https://models.mixlayer.ai/v1"
DEFAULT_OSS_KEY_ENV = "OSS_API_KEY"
DEFAULT_FRONTIER_KEY_ENV = "ANTHROPIC_API_KEY"

# Every generated file carries this string. Its absence in an existing file is how
# we tell "you edited this by hand" from "init wrote this last time".
MARKER = "Generated by bin/init"

ANSWERS_DOC = """\
answers file schema (--answers FILE, and what --print-answers emits)
-------------------------------------------------------------------
  version: 1                       # schema version, always 1
  team: acme                       # display name; also the config/ identity
  workspace_root: ~/workspace/acme # repos are cloned as siblings here
  tier: auto                       # auto | 128gb | 64gb | 32gb ("auto" stays
                                   #   portable: it re-detects on a new machine)
  repos:                           # cloned by bin/sync-workspace, in this order
    - name: acme-api               #   optional; inferred from remote when absent
      remote: git@github.com:acme/acme-api.git
      branch: main                 #   optional; defaults to the remote's default
      description: Public REST API and auth.   # optional, one line
  oss:                             # hosted OpenAI-compatible fallback rung
    enabled: true
    base_url: https://models.mixlayer.ai/v1
    api_key_env: OSS_API_KEY
  frontier:
    enabled: false
    api_key_env: ANTHROPIC_API_KEY

Only `team` is really required; everything else falls back to the defaults above.
`--workspace PATH` overrides `workspace_root` from the file.
"""

EPILOG = ANSWERS_DOC + """
examples
--------
  bin/init                                  # interactive, six questions
  bin/init --answers team.yaml --force      # reproducible re-generation
  bin/init --print-answers > team.yaml      # capture the interactive session
  bin/init --no-symlinks                    # generate config/ only
"""


# --------------------------------------------------------------------------
# Small prompt helpers. Prompts go to stderr so stdout stays machine-readable.
# --------------------------------------------------------------------------


def _readline() -> str:
    line = sys.stdin.readline()
    if not line:  # EOF: the user hit ctrl-D or stdin ran out
        raise h.HarnessError(
            "input stream closed before the questions were done; "
            "re-run with --answers FILE or --non-interactive"
        )
    return line.strip()


def ask(msg: str, default: str = "") -> str:
    suffix = f" [{default}]" if default else ""
    sys.stderr.write(f"{msg}{suffix}: ")
    sys.stderr.flush()
    return _readline() or default


def ask_yes(msg: str, default: bool = True) -> bool:
    suffix = "[Y/n]" if default else "[y/N]"
    while True:
        sys.stderr.write(f"{msg} {suffix}: ")
        sys.stderr.flush()
        answer = _readline().lower()
        if not answer:
            return default
        if answer in ("y", "yes"):
            return True
        if answer in ("n", "no"):
            return False


def ask_lines(msg: str) -> list[str]:
    """Read pasted lines until a blank one."""
    h.info(msg)
    out: list[str] = []
    while True:
        sys.stderr.write("  > ")
        sys.stderr.flush()
        line = _readline()
        if not line:
            return out
        out.append(line)


def slugify(text: str) -> str:
    keep = [c if (c.isalnum() or c in "-_") else "-" for c in text.strip().lower()]
    return "-".join(filter(None, "".join(keep).split("-"))) or "workspace"


# --------------------------------------------------------------------------
# Answers: collected interactively or read from a file; one shape either way.
# --------------------------------------------------------------------------


def repo_name_from_remote(remote: str) -> str:
    return remote.rstrip("/").rsplit("/", 1)[-1].removesuffix(".git")


def normalize_answers(raw: dict[str, Any]) -> dict[str, Any]:
    if not isinstance(raw, dict):
        raise h.HarnessError("answers file must be a YAML mapping; see --help")
    version = raw.get("version", 1)
    if int(version) != 1:
        raise h.HarnessError(f"answers version {version!r} is not supported (expected 1)")

    team = str(raw.get("team") or "workspace").strip()
    default_ws = Path.home() / "workspace"
    if slugify(team) != "workspace":
        default_ws = default_ws / slugify(team)
    ws = raw.get("workspace_root") or default_ws
    tier = str(raw.get("tier") or "auto").lower()
    h.resolve_tier(tier)  # validates; raises HarnessError on a typo

    repos: list[dict[str, Any]] = []
    for entry in raw.get("repos") or []:
        if isinstance(entry, str):
            entry = {"remote": entry}
        if not isinstance(entry, dict):
            raise h.HarnessError(f"repos entry must be a string or mapping, got {entry!r}")
        remote = str(entry.get("remote") or "").strip()
        name = str(entry.get("name") or "").strip() or (
            repo_name_from_remote(remote) if remote else ""
        )
        if not name:
            raise h.HarnessError(f"repos entry needs a name or a remote: {entry!r}")
        if not remote:
            raise h.HarnessError(f"repo {name!r} has no remote; bin/sync-workspace needs one")
        repos.append(
            {
                "name": name,
                "remote": remote,
                "branch": (str(entry.get("branch")).strip() if entry.get("branch") else None),
                "description": str(entry.get("description") or "").strip(),
            }
        )

    oss_raw = raw.get("oss") or {}
    frontier_raw = raw.get("frontier") or {}
    return {
        "version": 1,
        "team": team,
        "workspace_root": str(Path(str(ws)).expanduser()),
        "tier": tier,
        "repos": repos,
        "oss": {
            "enabled": bool(oss_raw.get("enabled", False)),
            "base_url": str(oss_raw.get("base_url") or DEFAULT_OSS_BASE),
            "api_key_env": str(oss_raw.get("api_key_env") or DEFAULT_OSS_KEY_ENV),
        },
        "frontier": {
            "enabled": bool(frontier_raw.get("enabled", False)),
            "api_key_env": str(frontier_raw.get("api_key_env") or DEFAULT_FRONTIER_KEY_ENV),
        },
    }


def answers_to_yaml(ans: dict[str, Any]) -> str:
    """Dump answers as YAML that --answers reads back identically."""
    out = dict(ans)
    out["repos"] = [{k: v for k, v in r.items() if v} for r in ans["repos"]]
    return yaml.safe_dump(out, sort_keys=False, default_flow_style=False, width=100)


# --------------------------------------------------------------------------
# Interactive collection: the six questions
# --------------------------------------------------------------------------


def git_out(repo: Path, *args: str) -> str:
    try:
        proc = subprocess.run(
            ["git", "-C", str(repo), *args], capture_output=True, text=True, timeout=15
        )
    except (OSError, subprocess.SubprocessError):
        return ""
    return proc.stdout.strip() if proc.returncode == 0 else ""


def repos_from_directory(directory: Path) -> list[dict[str, Any]]:
    """Infer repo entries from a directory of existing checkouts."""
    if not directory.is_dir():
        raise h.HarnessError(f"not a directory: {directory}")
    found: list[dict[str, Any]] = []
    for child in sorted(p for p in directory.iterdir() if p.is_dir()):
        if not (child / ".git").exists():
            continue
        remote = git_out(child, "remote", "get-url", "origin")
        if not remote:
            h.warn(f"{child.name}: no `origin` remote, skipping")
            continue
        branch = git_out(child, "rev-parse", "--abbrev-ref", "HEAD")
        found.append(
            {
                "name": child.name,
                "remote": remote,
                "branch": branch if branch and branch != "HEAD" else None,
                "description": "",
            }
        )
    return found


def collect_interactive() -> dict[str, Any]:
    h.info("")
    h.info(h.bold("agent-harness init") + " -- six questions, Enter takes the default.")
    h.info("")

    # 1. Workspace root (the team slug comes first because the default is built from it).
    h.step("1/6  Workspace")
    team = ask("Team name (short, used in paths and config)", "workspace")
    default_ws = Path.home() / "workspace" / slugify(team)
    workspace_root = ask("Workspace root -- repos are cloned as siblings here", str(default_ws))

    # 2. Repos: a directory of checkouts, or pasted remotes.
    h.step("2/6  Repos")
    h.info("The quickest route is a directory you have already cloned into.")
    repos: list[dict[str, Any]] = []
    directory = ask("Directory of existing checkouts (blank to paste remotes instead)", "")
    if directory:
        repos = repos_from_directory(Path(directory).expanduser())
        if repos:
            h.ok(f"found {len(repos)}: " + ", ".join(r["name"] for r in repos))
        else:
            h.warn("no git checkouts found there")
    if not repos:
        remotes = ask_lines("Paste git remotes, one per line, blank line to finish:")
        repos = [
            {
                "name": repo_name_from_remote(r),
                "remote": r,
                "branch": None,
                "description": "",
            }
            for r in remotes
        ]
    if not repos:
        h.warn("no repos configured -- bin/sync-workspace will have nothing to do")

    # 3. Hardware tier.
    h.step("3/6  Hardware")
    ram, detected = h.detect_ram_gb(), h.detect_tier()
    h.info(f"Detected {ram}GB RAM -> tier {h.bold(detected)}.")
    h.info(
        "Keeping auto-detection means this config still fits when you move to a "
        "bigger machine; pinning a tier freezes it to " + detected + " everywhere."
    )
    tier = "auto"
    if not ask_yes("Auto-detect the tier on every run (writes `tier: auto`)?", True):
        while True:
            choice = ask(f"Pin which tier ({'/'.join(h.TIERS)})", detected).lower()
            if choice in h.TIERS:
                tier = choice
                break
            h.warn(f"expected one of {', '.join(h.TIERS)}")

    # 4. Hosted OSS provider.
    h.step("4/6  Hosted open-source provider")
    h.info("An OpenAI-compatible endpoint (Mixlayer, Together, Fireworks, OpenRouter).")
    h.info("It is the fallback rung under local-big, and on the 32gb tier it *is* local-big.")
    oss = {"enabled": False, "base_url": DEFAULT_OSS_BASE, "api_key_env": DEFAULT_OSS_KEY_ENV}
    if ask_yes("Use a hosted provider (answer no to stay local-only)?", True):
        oss = {
            "enabled": True,
            "base_url": ask("Base URL", DEFAULT_OSS_BASE),
            "api_key_env": ask("Environment variable holding the key", DEFAULT_OSS_KEY_ENV),
        }
    else:
        effective = h.resolve_tier(tier)
        h.warn("no hosted rung: local-big has no fallback if Ollama stalls or dies")
        if effective == "32gb":
            h.warn(
                "on the 32gb tier local-big is *meant* to be hosted -- without a key it "
                "degrades to a small local model that drops details when summarizing"
            )

    # 5. Frontier key.
    h.step("5/6  Frontier provider")
    h.info("Always optional: Claude Code and Codex authenticate themselves.")
    frontier_enabled = ask_yes(
        f"Will you export {DEFAULT_FRONTIER_KEY_ENV} for harness paths that call a frontier model?",
        False,
    )

    # 6. Team name and per-repo descriptions.
    h.step("6/6  Descriptions")
    team = ask("Team name for the workspace context document", team)
    for repo in repos:
        repo["description"] = ask(f"  {repo['name']} -- one line", repo["description"])

    return normalize_answers(
        {
            "version": 1,
            "team": team,
            "workspace_root": workspace_root,
            "tier": tier,
            "repos": repos,
            "oss": oss,
            "frontier": {"enabled": frontier_enabled, "api_key_env": DEFAULT_FRONTIER_KEY_ENV},
        }
    )


# --------------------------------------------------------------------------
# Planned writes: render everything first, then decide what may be overwritten.
# --------------------------------------------------------------------------


@dataclass
class Planned:
    path: Path
    text: str
    write: Callable[[], None]
    protected: bool = False  # extra-loud handling: a hand-edited file lives here
    status: str = field(default="create", init=False)

    def classify(self) -> None:
        if not self.path.exists():
            self.status = "create"
        elif self.path.read_text() == self.text:
            self.status = "unchanged"
        else:
            self.status = "modify"

    @property
    def hand_edited(self) -> bool:
        return (
            self.status == "modify"
            and self.path.exists()
            and MARKER not in self.path.read_text(errors="replace")
        )


def render_yaml(data: Any, header: str) -> str:
    """Exact bytes h.save_yaml would write, so we can diff before committing."""
    with tempfile.TemporaryDirectory() as tmp:
        probe = Path(tmp) / "probe.yaml"
        h.save_yaml(probe, data, header=header)
        return probe.read_text()


def build_harness_yaml(ans: dict[str, Any], path: Path) -> Planned:
    cfg = h.Config(
        team=ans["team"],
        workspace_root=Path(ans["workspace_root"]),
        tier_setting=ans["tier"],
        oss_enabled=ans["oss"]["enabled"],
        frontier_enabled=ans["frontier"]["enabled"],
    )
    data = cfg.to_dict()
    # The shape comes from Config.to_dict(); only the key name is an answer.
    data["oss"]["api_key_env"] = ans["oss"]["api_key_env"]
    data["frontier"]["api_key_env"] = ans["frontier"]["api_key_env"]
    header = (
        f"{MARKER}. Safe to hand-edit; re-running init needs --force to replace it.\n"
        "tier: auto re-detects RAM on every run, which is what makes this directory\n"
        "portable between machines. Pin 128gb/64gb/32gb only to override detection.\n"
        "The hosted rung reads its URL and key from the environment, not from here:\n"
        f"export OSS_API_BASE={ans['oss']['base_url']} in .envrc."
    )
    text = render_yaml(data, header)
    return Planned(path, text, lambda: h.save_yaml(path, data, header=header))


def build_repos_yaml(ans: dict[str, Any], path: Path) -> Planned:
    repos = []
    for r in ans["repos"]:
        entry: dict[str, Any] = {"name": r["name"], "remote": r["remote"]}
        if r["branch"]:
            entry["branch"] = r["branch"]
        if r["description"]:
            entry["description"] = r["description"]
        repos.append(entry)
    data = {"repos": repos}
    header = (
        f"{MARKER}. Repos bin/sync-workspace clones under the workspace root.\n"
        "name is inferred from remote when omitted; branch and description are optional."
    )
    text = render_yaml(data, header)
    return Planned(path, text, lambda: h.save_yaml(path, data, header=header))


def build_tier_overrides(path: Path) -> Planned:
    text = f"""\
# {MARKER}. Empty on purpose: the tier defaults in lib/harness_lib.py win.
#
# Pin a model here only when the default is wrong for your team -- a tag you do not
# have pulled, a model that behaves badly on your code, or a keep_alive that fights
# with the rest of your machine. Anything you set applies to every tier.
#
# models:
#   local-big: ollama/some-model:tag
#   local-fast: ollama/some-smaller-model:tag
# keep_alive: 10m
"""
    return Planned(path, text, lambda: path.write_text(text))


def build_workspace_context(ans: dict[str, Any], path: Path) -> Planned:
    team = ans["team"]
    ws = ans["workspace_root"]
    rows = []
    for r in ans["repos"]:
        desc = (r["description"] or "_no description yet_").replace("|", "\\|")
        rows.append(f"| `{r['name']}` | {r['branch'] or 'default'} | {desc} |")
    table = (
        "\n".join(
            ["| repo | branch | what it is |", "| --- | --- | --- |", *rows]
        )
        if rows
        else "No repos configured yet. Add them to `config/repos.yaml` and re-run init."
    )
    text = f"""\
<!-- {MARKER}. Hand-edited copies are never replaced without --force. -->
# {team} workspace

Loaded into every agent session started in `{ws}` (`CLAUDE.md` and `AGENTS.md` there
are symlinks to this file). Every line costs tokens in every session -- keep it short,
and delete anything an agent can read from the code just as easily.

`/harness-init` inside Claude Code writes a far better version of this file: it reads
the actual repos and describes what is really there. Treat what follows as scaffolding.

## Layout

Repos are siblings under `{ws}`. Start agents from that directory, not from inside a
single repo, so cross-repo edits stay in one session.

## Repos

{table}

## Cross-repo contracts

Nothing recorded yet. List the interfaces that break another repo when they change --
shared schemas, event names, API versions, generated clients -- one line each, naming
the repo that owns it. This is the part agents cannot infer from a single repo.

## Conventions

Workspace-wide rules only (release order, shared tooling, what never gets touched
without review). Per-repo conventions belong in that repo's own `CLAUDE.md` /
`AGENTS.md`, where they load only when the repo is in play.
"""
    return Planned(path, text, lambda: path.write_text(text), protected=True)


# --------------------------------------------------------------------------
# Workspace wiring
# --------------------------------------------------------------------------


@dataclass
class Wiring:
    links: list[str] = field(default_factory=list)
    skipped: list[str] = field(default_factory=list)


def _backup(path: Path) -> Path:
    backup = path.with_suffix(path.suffix + ".bak")
    n = 1
    while backup.exists():
        backup = path.with_suffix(path.suffix + f".bak{n}")
        n += 1
    path.replace(backup)
    return backup


def link(target: Path, dest: Path, force: bool, wiring: Wiring) -> None:
    """Point ``dest`` at ``target``. Real files are never clobbered without --force."""
    dest.parent.mkdir(parents=True, exist_ok=True)
    if dest.is_symlink():
        if Path(os.readlink(dest)) == target:
            wiring.links.append(f"{dest} -> {target} (already)")
            return
        dest.unlink()
    elif dest.exists():
        if not force:
            h.warn(f"{dest} exists and is not a symlink -- skipped (use --force to replace)")
            wiring.skipped.append(str(dest))
            return
        backup = _backup(dest)
        h.warn(f"{dest} moved to {backup.name}")
    dest.symlink_to(target)
    wiring.links.append(f"{dest} -> {target}")
    h.ok(f"link {dest}")


def render_template(src: Path, dest: Path, root: Path, force: bool, wiring: Wiring) -> None:
    """Copy a template, substituting the harness root placeholder."""
    if not src.exists():
        h.warn(
            f"{src.name} is not in this checkout yet -- skipping {dest.name}. "
            "Re-run `bin/init` after `git pull` to write it."
        )
        wiring.skipped.append(str(dest))
        return
    text = src.read_text().replace("__HARNESS_ROOT__", str(root))
    if dest.exists() and not dest.is_symlink():
        if dest.read_text() == text:
            wiring.links.append(f"{dest} (already current)")
            return
        if not force:
            h.warn(f"{dest} exists with different content -- skipped (use --force to replace)")
            wiring.skipped.append(str(dest))
            return
        backup = _backup(dest)
        h.warn(f"{dest} moved to {backup.name}")
    elif dest.is_symlink():
        dest.unlink()
    dest.parent.mkdir(parents=True, exist_ok=True)
    dest.write_text(text)
    wiring.links.append(f"{dest} (rendered from {src.name})")
    h.ok(f"render {dest}")


def wire_workspace(root: Path, ws: Path, context: Path, force: bool) -> Wiring:
    wiring = Wiring()
    h.step(f"Wiring {ws}")
    ws.mkdir(parents=True, exist_ok=True)
    for name in ("CLAUDE.md", "AGENTS.md"):
        link(context, ws / name, force, wiring)

    commands = sorted((root / "claude" / "commands").glob("*.md"))
    if not commands:
        h.warn("no slash commands in claude/commands -- skipping command links")
    for cmd in commands:
        link(cmd, ws / ".claude" / "commands" / cmd.name, force, wiring)

    render_template(root / "claude" / "mcp.json.template", ws / ".mcp.json", root, force, wiring)
    render_template(
        root / "claude" / "settings.template.json",
        ws / ".claude" / "settings.json",
        root,
        force,
        wiring,
    )
    return wiring


# --------------------------------------------------------------------------
# main
# --------------------------------------------------------------------------


def parse_args(argv: list[str] | None = None) -> argparse.Namespace:
    p = argparse.ArgumentParser(
        prog="bin/init",
        description=(
            "Generate config/harness.yaml, config/repos.yaml, config/tier-overrides.yaml "
            "and config/workspace-context.md, then symlink the workspace directory at them. "
            "Safe to re-run: existing files are only replaced with --force."
        ),
        epilog=EPILOG,
        formatter_class=argparse.RawDescriptionHelpFormatter,
    )
    p.add_argument("--answers", metavar="FILE", help="YAML answers file (schema below)")
    p.add_argument("--workspace", metavar="PATH", help="override workspace_root")
    p.add_argument(
        "--non-interactive",
        action="store_true",
        help="never prompt; use --answers, or defaults for everything",
    )
    p.add_argument(
        "--force", action="store_true", help="replace existing config files (backs them up first)"
    )
    p.add_argument(
        "--print-answers",
        action="store_true",
        help="print the collected answers as YAML on stdout and exit, writing nothing",
    )
    p.add_argument("--no-symlinks", action="store_true", help="generate config/ only")
    return p.parse_args(argv)


def summarize(
    cfg: h.Config, ans: dict[str, Any], written: list[Planned], wiring: Wiring | None
) -> None:
    root = h.harness_root()
    h.info("")
    h.step("Summary")
    pinned = "pinned" if cfg.tier_is_pinned else f"auto ({h.detect_ram_gb()}GB detected)"
    h.info(f"  team          {cfg.team}")
    h.info(f"  tier          {cfg.tier}  [{pinned}]")
    h.info(f"  workspace     {cfg.workspace_root}")
    h.info(f"  repos         {len(ans['repos'])}")
    changed = [p for p in written if p.status != "unchanged"]
    h.info(f"  files written {len(changed)} of {len(written)} in {root / 'config'}")
    for p in written:
        h.info(f"                {p.status:9} {p.path.name}")
    if wiring is None:
        h.info("  symlinks      skipped (--no-symlinks)")
    else:
        h.info(f"  symlinks      {len(wiring.links)} wired, {len(wiring.skipped)} skipped")

    if ans["oss"]["enabled"]:
        h.info("")
        h.info(f"  Set OSS_API_BASE={ans['oss']['base_url']} and {ans['oss']['api_key_env']}")
        h.info("  in .envrc (copy .envrc.template) before starting the proxy.")

    h.info("")
    h.info(h.bold("  Try next"))
    h.info("    ./setup.sh            install and start the LiteLLM proxy")
    h.info("    bin/local health      check the aliases answer")
    h.info("    bin/sync-workspace    clone or pull every repo in config/repos.yaml")
    h.info(f"    cd {cfg.workspace_root} && claude   then /fix-issue to drive a first task")
    if not h.litellm_up(cfg):
        h.info("")
        h.warn(f"LiteLLM is not answering on {cfg.base_url} -- run ./setup.sh first")


def main(argv: list[str] | None = None) -> int:
    args = parse_args(argv)
    root = h.harness_root()

    if args.answers:
        ans = normalize_answers(h.load_yaml(Path(args.answers).expanduser()) or {})
    elif args.non_interactive:
        # No file and no questions: a bare default config, useful for smoke tests.
        h.warn("--non-interactive without --answers: generating defaults, no repos")
        ans = normalize_answers({"version": 1})
    else:
        ans = collect_interactive()

    if args.workspace:
        ans["workspace_root"] = str(Path(args.workspace).expanduser())

    if args.print_answers:
        sys.stdout.write(answers_to_yaml(ans))
        return 0

    if ans["oss"]["enabled"] and ans["oss"]["api_key_env"] != DEFAULT_OSS_KEY_ENV:
        # The LiteLLM profiles read os.environ/OSS_API_KEY by name, so a different
        # variable only works if .envrc also exports OSS_API_KEY from it.
        h.warn(
            f"the LiteLLM profiles read {DEFAULT_OSS_KEY_ENV}, not "
            f"{ans['oss']['api_key_env']} -- add "
            f"`export {DEFAULT_OSS_KEY_ENV}=\"${ans['oss']['api_key_env']}\"` to .envrc"
        )

    cfgdir = h.config_dir()
    planned = [
        build_harness_yaml(ans, cfgdir / "harness.yaml"),
        build_repos_yaml(ans, cfgdir / "repos.yaml"),
        build_tier_overrides(cfgdir / "tier-overrides.yaml"),
        build_workspace_context(ans, cfgdir / "workspace-context.md"),
    ]
    for p in planned:
        p.classify()

    conflicts = [p for p in planned if p.status == "modify"]
    if conflicts and not args.force:
        h.error(f"{cfgdir} already has content that differs from what init would write:")
        for p in conflicts:
            note = "  <- hand-edited, no init marker" if p.hand_edited else ""
            h.info(f"    would rewrite {p.path.name}{note}")
        for p in planned:
            if p.status != "modify":
                h.info(f"    {p.status:9} {p.path.name}")
        raise h.HarnessError(
            "refusing to overwrite. Re-run with --force (each replaced file is backed "
            "up to config/<name>.bak first), or edit those files by hand."
        )

    h.step(f"Writing {cfgdir}")
    cfgdir.mkdir(parents=True, exist_ok=True)
    for p in planned:
        if p.status == "unchanged":
            h.info(f"  unchanged {p.path.name}")
            continue
        if p.status == "modify":
            loud = p.protected or p.hand_edited  # evaluate before the file moves
            backup = _backup(p.path)
            (h.warn if loud else h.info)(f"  backed up {p.path.name} -> {backup.name}")
        p.write()
        h.ok(f"{p.status:9}{p.path.name}")

    cfg = h.load_config()
    wiring = None
    if not args.no_symlinks:
        wiring = wire_workspace(
            root, cfg.workspace_root, cfgdir / "workspace-context.md", args.force
        )

    summarize(cfg, ans, planned, wiring)
    return 0


if __name__ == "__main__":
    try:
        raise SystemExit(main())
    except h.HarnessError as exc:
        h.die(str(exc))
    except KeyboardInterrupt:
        h.die("interrupted", 130)
