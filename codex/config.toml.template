# Codex CLI pointed at the harness LiteLLM proxy, so Codex and Claude Code share
# one alias contract and one usage journal.
#
#   mkdir -p ~/.codex
#   cp codex/config.toml.template ~/.codex/config.toml
#
# WARNING: only do that copy if you separately want to drive Codex CLI itself off
# local models. It BREAKS frontier delegation. The `delegate` MCP server is the
# frontier rung by definition and rejects harness aliases outright, so a
# ~/.codex/config.toml pointed at this proxy makes `/delegate` either run on a
# local model or die with a context error. Delegation wants nothing from this
# file -- trust entries plus `codex login` are its whole requirement.
#
# If you already have a ~/.codex/config.toml -- and you do, if you use delegation
# -- merge the [model_providers.harness] and [profiles.*] blocks into it under a
# named profile instead of overwriting the file.
#
# Requires the proxy to be running: ./setup.sh --start
#
# Model names here are ALWAYS the harness aliases -- local-big, local-fast,
# local-embed -- never a concrete model. The alias -> model mapping lives in
# litellm/profiles/<tier>.yaml, which is what makes moving to a bigger machine a
# no-op for every config that references it.

model = "local-fast"
model_provider = "harness"

[model_providers.harness]
name = "Agent harness (LiteLLM)"
base_url = "http://127.0.0.1:4000/v1"
# Codex reads the key from this environment variable; .envrc sets it, and the
# harness default is sk-harness-local.
env_key = "LITELLM_MASTER_KEY"
# Must be "responses", not "chat". Codex CLI dropped support for the chat wire
# API (verified against codex-cli 0.145.0, which refuses to start with
# `wire_api = "chat" is no longer supported`). LiteLLM serves /v1/responses and
# bridges it to the Ollama backend, so the aliases work unchanged.
wire_api = "responses"

# Local models are slower than a hosted frontier endpoint, and on the 32GB tier
# local-big is a hosted call over the network. Give both room before timing out.
request_max_retries = 2
stream_max_retries = 3
stream_idle_timeout_ms = 300000

# Known rough edge: Codex has no metadata for these alias names, so it warns
# ("Model metadata for `local-fast` not found") and assumes a very large context
# window -- 258k in a run here, against a 7B model actually serving 32k. It will
# happily overpack the prompt. If you see truncation or gibberish on long tasks,
# pin the context window for the alias in your Codex config rather than trusting
# the default, and prefer `--profile big` for anything context-heavy.

# `codex --profile big` for compression and review passes; the default profile
# above stays on local-fast for drafts and short edits.
[profiles.big]
model = "local-big"
model_provider = "harness"

[profiles.fast]
model = "local-fast"
model_provider = "harness"
